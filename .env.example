# Milestone 4: copy this file to .env for local overrides.
# .env is ignored by git because it may contain secrets.

COMPOSE_PROJECT_NAME=dockyard

FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8080
# Milestone 17: proxy mode publishes Nginx as the gateway on this host port.
NGINX_HOST_PORT=3000
# Milestone 20: local registry publishes this host port for docker push/pull practice.
REGISTRY_HOST_PORT=5000
POSTGRES_HOST_PORT=5432

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
WORKER_ID=dockyard-worker-1
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_HEARTBEAT_STALE_AFTER_MS=30000
WORKER_POLL_INTERVAL_MS=3000
DEPLOYMENT_STEP_DELAY_MS=1000
# Milestone 14: keep worker resource stress off unless you are observing docker stats.
WORKER_STRESS_MODE=off
WORKER_STRESS_DURATION_MS=500

POSTGRES_USER=dockyard
POSTGRES_PASSWORD=dockyard_dev_password
POSTGRES_DB=dockyard

DATABASE_URL=postgres://dockyard:dockyard_dev_password@postgres:5432/dockyard
REDIS_URL=redis://redis:6379
